    "url": "https://github.com/drsaavedra/sf-tester-agent/issues"
  },
  "homepage": "https://github.com/drsaavedra/sf-tester-agent#readme",
  "engines": {
    "node": ">=22.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "playwright-core": "1.56.1",
    "zod": "3.25.76"
