<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SfUiC_Size_Not_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>Size__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Size__c</errorDisplayField>
    <errorMessage>SFUIC field error: Size cannot be negative</errorMessage>
</ValidationRule>
