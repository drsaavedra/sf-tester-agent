<apex:page standardController="SfUiC_Ovr__c" lightningStylesheets="true">
    <h1>SFUIC Override Edit (Visualforce)</h1>
    <apex:form>
        <apex:pageMessages/>
        <apex:pageBlock title="SFUIC Override Edit">
            <apex:pageBlockButtons>
                <apex:commandButton action="{!save}" value="Save"/>
                <apex:commandButton action="{!cancel}" value="Cancel" immediate="true"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="1">
                <apex:inputField value="{!SfUiC_Ovr__c.Name}"/>
                <apex:inputField value="{!SfUiC_Ovr__c.Guard__c}"/>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>
